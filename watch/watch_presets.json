{
  "_schemaVersion": 1,
  "presets": [
    {
      "id": "core_memory", "label": "Bellek sagligi", "always": true,
      "items": [
        { "role": "heapEnd", "symbol": "__sbrk_heap_end", "type": "u32", "format": "hex" },
        { "role": "bssEnd",  "symbol": "_end",            "type": "u32", "format": "hex", "constant": true }
      ]
    },
    {
      "id": "stack_watermark", "label": "Stack watermark (yalnizca boyanan stack)",
      "_note": "Gated on StackPaint_Init: the scan only means something when the firmware painted the stack with the pattern first. On a firmware that did not, the very first word mismatches and the item reads ~0 B - a false 'stack exhausted' alarm - while scanning the whole region every sample cuts the sample rate (200 -> ~54 Hz measured on the N6 reference project).",
      "requiresAnySymbol": ["StackPaint_Init"],
      "items": [
        { "role": "stackWatermark", "kind": "regionScan",
          "regionFrom": ["_sstack", "_estack-_Min_Stack_Size"],
          "regionTo": "_estack", "pattern": "0xA5A5A5A5", "unit": "B", "rateHz": 2 }
      ]
    },
    {
      "id": "sensor_memory", "label": "Sensor ham degerleri (bellek, UART gerekmez)",
      "requiresAnySymbol": ["g_telemetry"],
      "items": [
        { "role": "sensor0", "label": "g_telemetry.sensor[0]", "symbol": "g_telemetry", "offset_bytes": 4,  "type": "f32", "unit": "",
          "guardBegin": { "symbol": "g_telemetry", "offset_bytes": 0 },
          "guardEnd":   { "symbol": "g_telemetry", "offset_bytes": 88 } },
        { "role": "sensor1", "label": "g_telemetry.sensor[1]", "symbol": "g_telemetry", "offset_bytes": 8,  "type": "f32", "unit": "",
          "guardBegin": { "symbol": "g_telemetry", "offset_bytes": 0 },
          "guardEnd":   { "symbol": "g_telemetry", "offset_bytes": 88 } },
        { "role": "sensor2", "label": "g_telemetry.sensor[2]", "symbol": "g_telemetry", "offset_bytes": 12, "type": "f32", "unit": "",
          "guardBegin": { "symbol": "g_telemetry", "offset_bytes": 0 },
          "guardEnd":   { "symbol": "g_telemetry", "offset_bytes": 88 } },
        { "role": "sensorOk", "label": "g_telemetry.sensor_ok", "symbol": "g_telemetry", "offset_bytes": 40, "type": "u32",
          "guardBegin": { "symbol": "g_telemetry", "offset_bytes": 0 },
          "guardEnd":   { "symbol": "g_telemetry", "offset_bytes": 88 } },
        { "role": "memInferUs", "label": "g_telemetry.inf_us",   "symbol": "g_telemetry", "offset_bytes": 44, "type": "u32", "unit": "us",
          "guardBegin": { "symbol": "g_telemetry", "offset_bytes": 0 },
          "guardEnd":   { "symbol": "g_telemetry", "offset_bytes": 88 } },
        { "role": "memInferCount", "label": "g_telemetry.infer_count", "symbol": "g_telemetry", "offset_bytes": 48, "type": "u32",
          "guardBegin": { "symbol": "g_telemetry", "offset_bytes": 0 },
          "guardEnd":   { "symbol": "g_telemetry", "offset_bytes": 88 } }
      ]
    },
    {
      "id": "bme280_labels", "label": "BME280 sensor kanallari",
      "requiresAnySymbol": ["BME280_ReadAll"],
      "relabels": [
        { "role": "sensor0", "label": "BME280 sicaklik", "unit": "°C" },
        { "role": "sensor1", "label": "BME280 nem",      "unit": "%" },
        { "role": "sensor2", "label": "BME280 basinc",   "unit": "hPa" }
      ]
    },
    {
      "id": "mpu6050_labels", "label": "MPU6050 sensor kanallari",
      "requiresAnySymbol": ["MPU6050_ReadAll"],
      "relabels": [
        { "role": "sensor0", "label": "MPU6050 ax", "unit": "m/s²" },
        { "role": "sensor1", "label": "MPU6050 ay", "unit": "m/s²" },
        { "role": "sensor2", "label": "MPU6050 az", "unit": "m/s²" }
      ]
    },
    {
      "id": "xcubeai_runtime", "label": "X-CUBE-AI calisma zamani",
      "requiresAnySymbol": ["s_network", "net_exec_ctx", "g_npu_exec_ctx", "NN_Instance_Default", "NN_Instance_network"],
      "items": [
        { "role": "inferenceUs", "symbol": "g_ai_last_inference_us", "type": "u32", "scale": 0.001, "unit": "ms" },
        { "role": "inferCount",  "symbol": "g_ai_infer_count",       "type": "u32" },
        { "role": "lastClass",   "symbol": "g_ai_last_class",        "type": "u8"  },
        { "role": "confidence",  "symbol": "g_ai_last_confidence",   "type": "u8", "unit": "%" },
        { "role": "confidence",  "symbol": "g_ai_last_confidence_pct", "type": "u32", "unit": "%" }
      ]
    },
    {
      "id": "hal_timebase", "label": "HAL zaman tabani", "always": true,
      "items": [ { "role": "hwTick", "symbol": "uwTick", "type": "u32", "unit": "ms" } ]
    }
  ]
}
